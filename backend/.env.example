# Copy to backend/.env and edit. Everything here is optional for local use.

# Required before deploying anywhere public: a long random string.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Optional AI librarian. Leave LLM_API_KEY empty to use the built-in search only.
LLM_PROVIDER=anthropic        # anthropic or openai
LLM_API_KEY=
# Model names change often; set the one you want to pay for.
# Defaults: claude-haiku-5-5 (anthropic), gpt-4o-mini (openai).
LLM_MODEL=

# Catalogue sync: adds popular new books from Open Library on a schedule.
# 24 = once a day. 0 = off (you can still run `python -m app.sync` by hand).
SYNC_INTERVAL_HOURS=24
# Comma-separated subjects to search, and how many new books per subject per run.
SYNC_SUBJECTS=fantasy,romance,mystery,thriller,science fiction,young adult fiction,historical fiction,horror
SYNC_PER_SUBJECT=3
# Only books first published in the last N years.
SYNC_SINCE_YEARS=3
# Open Library asks apps to identify themselves; with an email the sync may go 3x faster.
SYNC_CONTACT_EMAIL=
# Optional. Google Books fills in missing descriptions and works without a key at this volume.
GOOGLE_BOOKS_API_KEY=
